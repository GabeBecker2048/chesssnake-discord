# Copy to .env. Never commit .env.

# The Discord bot token (Developer Portal > your application > Bot > Reset Token).
DISCORD_TOKEN=

# The chesssnake server, and an api token for an *administrator* account there:
#   chesssnake user create discord-bot --admin --no-password
#   chesssnake user token discord-bot --name chesssnake-discord
# These are the names chesssnake's own client reads. With the Docker stack in
# compose.yaml, CHESSSNAKE__CLIENT__API_URL is set for you and this one is ignored.
CHESSSNAKE__CLIENT__API_URL=http://localhost:8000
CHESSSNAKE__CLIENT__TOKEN=

# Optional settings. Each is also a key in config.toml (see config.example.toml),
# named CHESSSNAKE_DISCORD__{SECTION}__{KEY}; these win over the file.
#
# The web UI's address, shown by /chess profile and /chess password:
# CHESSSNAKE_DISCORD__CHESSSNAKE__WEB_URL=https://chess.example
# How moves made outside Discord are relayed: auto, websocket, poll or off:
# CHESSSNAKE_DISCORD__LIVE__MODE=auto
# CHESSSNAKE_DISCORD__LIVE__POLL_INTERVAL_SECONDS=15
# The slash command group, if your bot already has a /chess:
# CHESSSNAKE_DISCORD__DISCORD__COMMAND_NAME=chess
# Register the commands in one server only, instantly (development):
# CHESSSNAKE_DISCORD__DISCORD__DEV_GUILD_ID=0
# Leave servers beyond this many (0: no cap):
# CHESSSNAKE_DISCORD__DISCORD__MAX_GUILDS=0
# Let server managers make accounts for everyone at once, and on join:
# CHESSSNAKE_DISCORD__DISCORD__BULK_ACCOUNTS=true
# Posted on joining a server and with every init:
# CHESSSNAKE_DISCORD__DISCORD__NOTICE=
# Discord user ids allowed the account commands of /chess admin, comma-separated:
# CHESSSNAKE_DISCORD__DISCORD__OWNER_IDS=
# The bot's own small database:
# CHESSSNAKE_DISCORD__STORAGE__PATH=chesssnake-discord.db
